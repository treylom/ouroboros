{
  "mcpServers": {
    "ouroboros": {
      "command": "uvx",
      "args": [
        "--isolated",
        "--python",
        ">=3.12",
        "--from",
        "git+https://github.com/treylom/ouroboros.git@km-v1[mcp]",
        "ouroboros",
        "mcp",
        "serve",
        "--runtime",
        "claude-cli",
        "--llm-backend",
        "claude_code"
      ]
    }
  }
}
