{
  "mcpServers": {
    "ouroboros": {
      "command": "uvx",
      "args": [
        "--isolated",
        "--python",
        ">=3.12",
        "--from",
        "ouroboros-ai[mcp]==0.53.0",
        "ouroboros",
        "mcp",
        "serve",
        "--runtime",
        "codex",
        "--llm-backend",
        "codex"
      ]
    },
    "searchflow": {
      "command": "node",
      "cwd": "./",
      "args": [
        "./skills/searchflow/scripts/mcp-server.mjs"
      ]
    }
  }
}
