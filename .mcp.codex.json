{
  "mcpServers": {
    "ouroboros": {
      "command": "uvx",
      "args": [
        "--isolated",
        "--python",
        ">=3.12",
        "--from",
        "git+https://github.com/treylom/ouroboros.git@2f5fbe1e52e1c75594c310c7d515b538aab4dc51[mcp]",
        "ouroboros",
        "mcp",
        "serve",
        "--runtime",
        "codex",
        "--llm-backend",
        "codex"
      ]
    },
    "searchflow": {
      "command": "node",
      "cwd": "./",
      "args": [
        "./skills/searchflow/scripts/mcp-server.mjs"
      ]
    }
  }
}
